[Unit]
Description=AetherMind PKM sync server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kang/aethermind_ai_native_pkm
Environment=NODE_ENV=production
ExecStart=/home/kang/.nvm/versions/node/v24.17.0/bin/node dist/server.cjs
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
